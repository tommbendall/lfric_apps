<file_definition>

  <!-- Initial fields to actually output by default -->
  <!-- This file will always be written out to CYLC_TASK_WORK_DIR as it is hardwired in the code -->
  <file id="lfric_initial" name="lfric_initial" output_freq="1ts" convention="UGRID" enabled=".TRUE.">
    <field_group operation="once" freq_op="1ts" prec="4">
      <field field_ref="init_area_at_msl" />
    </field_group>
  </file>

  <!-- Diagnostic fields - Daily - mean/min/max -->

