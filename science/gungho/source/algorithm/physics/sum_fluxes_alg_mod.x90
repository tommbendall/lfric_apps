!> @brief Integrate a W3 field as though it were a finite difference
!>        representation
module sum_fluxes_alg_mod

  use moisture_energy_flux_kernel_mod, only: moisture_energy_flux_kernel_type
  use sci_multi_extract_kernel_mod,    only: multi_extract_kernel_type
  use energy_correction_config_mod,    only: new_calculation

  implicit none

  private
  public :: sum_fluxes_alg

contains

  subroutine sum_fluxes_alg( accumulated_fluxes, radiation_fields, turbulence_fields, &
                             convection_fields, microphysics_fields,                   &
                             theta, derived_fields )

    use constants_mod,              only: r_def
    use driver_water_constants_mod, only: Lv0 => latent_heat_h2o_condensation, &
                                          Lf0 => latent_heat_h2o_fusion,       &
                                          cpv => heat_capacity_h2o_vapour,     &
                                          cl  => heat_capacity_h2o,            &
                                          ci  => heat_capacity_ice,            &
                                          Rv  => gas_constant_h2o,             &
                                          Tm => T_freeze_h2o
    use field_mod,                  only: field_type
    use field_collection_mod,       only: field_collection_type
    use formulation_config_mod,     only: gungho_cp, gungho_cp_none,           &
                                          gungho_cp_dry, gungho_cp_moist
    use planet_config_mod,          only: cpd => cp, gravity
    use extrusion_config_mod,       only: planet_radius

    implicit none

    type( field_type ), intent(inout)         :: accumulated_fluxes
    type( field_collection_type ), intent(in) :: radiation_fields
    type( field_collection_type ), intent(in) :: turbulence_fields
    type( field_collection_type ), intent(in) :: convection_fields
    type( field_collection_type ), intent(in) :: microphysics_fields
    type( field_type ),            intent(in) :: theta
    type( field_collection_type ), intent(in) :: derived_fields

    real( kind=r_def ) :: Lvr, Lsr, graup_factor
    real( kind=r_def ) :: cpv_local, cl_local, ci_local, Rv_local

    type( field_type ), pointer :: heat_flux_bl => null()
    type( field_type ), pointer :: moist_flux_bl => null()
    type( field_type ), pointer :: sw_direct_toa_rts => null()
    type( field_type ), pointer :: sw_up_toa_rts => null()
    type( field_type ), pointer :: lw_up_toa_rts => null()
    type( field_type ), pointer :: sw_down_surf_rts => null()
    type( field_type ), pointer :: sw_up_surf_rts => null()
    type( field_type ), pointer :: lw_down_surf_rts => null()
    type( field_type ), pointer :: lw_up_surf_rts => null()
    type( field_type ), pointer :: ls_rain => null()
    type( field_type ), pointer :: ls_snow => null()
    type( field_type ), pointer :: ls_graup => null()
    type( field_type ), pointer :: conv_rain => null()
    type( field_type ), pointer :: conv_snow => null()
    type( field_type ), pointer :: exner_in_wth => null()
    type( field_type ), pointer :: u_in_w3 => null()
    type( field_type ), pointer :: v_in_w3 => null()

    type( field_type )          :: heat_flux_surf
    type( field_type )          :: vap_in_total, liq_out_total, ice_out_total
    type( field_type )          :: theta_surf, exner_surf, u_surf, v_surf

    ! Set heat capacities and latent heats
    select case(gungho_cp)
    case(gungho_cp_none)
      cpv_local = 0.0_r_def
      cl_local = 0.0_r_def
      ci_local = 0.0_r_def
      Rv_local = 0.0_r_def
    case(gungho_cp_dry)
      cpv_local = cpd
      cl_local = cpd
      ci_local = cpd
      Rv_local = 0.0_r_def
    case(gungho_cp_moist)
      cpv_local = cpv
      cl_local = cl
      ci_local = ci
      Rv_local = Rv
    end select

    Lvr = Lv0 + (cl_local - cpv_local)*Tm
    Lsr = Lvr + Lf0 + (ci_local - cl_local)*Tm

    ! Set graup_factor AFTER Lsr is computed
    select case(gungho_cp)
    case(gungho_cp_moist)
      graup_factor = Lsr
    case default
      graup_factor = 0.0_r_def
    end select

    call turbulence_fields%get_field('heat_flux_bl', heat_flux_bl)
    call turbulence_fields%get_field('moist_flux_bl', moist_flux_bl)
    call radiation_fields%get_field('sw_direct_toa_rts', sw_direct_toa_rts)
    call radiation_fields%get_field('sw_up_toa_rts', sw_up_toa_rts)
    call radiation_fields%get_field('lw_up_toa_rts', lw_up_toa_rts)
    call radiation_fields%get_field('sw_down_surf_rts', sw_down_surf_rts)
    call radiation_fields%get_field('sw_up_surf_rts', sw_up_surf_rts)
    call radiation_fields%get_field('lw_down_surf_rts', lw_down_surf_rts)
    call radiation_fields%get_field('lw_up_surf_rts', lw_up_surf_rts)
    call microphysics_fields%get_field('ls_rain', ls_rain)
    call microphysics_fields%get_field('ls_snow', ls_snow)
    call microphysics_fields%get_field('ls_graup', ls_graup)
    call convection_fields%get_field('conv_rain', conv_rain)
    call convection_fields%get_field('conv_snow', conv_snow)

    call ls_rain%copy_field_properties(heat_flux_surf)
    call ls_rain%copy_field_properties(vap_in_total)
    call ls_rain%copy_field_properties(liq_out_total)
    call ls_rain%copy_field_properties(ice_out_total)

    call invoke( multi_extract_kernel_type(heat_flux_surf, heat_flux_bl, 1, 1), &
                 multi_extract_kernel_type(vap_in_total, moist_flux_bl, 1, 1),  &
                 inc_X_plus_Y(accumulated_fluxes, heat_flux_surf),              &
                 inc_X_plus_Y(accumulated_fluxes, sw_direct_toa_rts),           &
                 inc_X_minus_Y(accumulated_fluxes, sw_up_toa_rts),              &
                 inc_X_minus_Y(accumulated_fluxes, lw_up_toa_rts),              &
                 inc_X_minus_Y(accumulated_fluxes, sw_down_surf_rts),           &
                 inc_X_plus_Y(accumulated_fluxes, sw_up_surf_rts),              &
                 inc_X_minus_Y(accumulated_fluxes, lw_down_surf_rts),           &
                 inc_X_plus_Y(accumulated_fluxes, lw_up_surf_rts),              &
                 inc_X_plus_bY(accumulated_fluxes, Lvr, ls_rain),               &
                 inc_X_plus_bY(accumulated_fluxes, Lsr, ls_snow),               &
                 inc_X_plus_bY(accumulated_fluxes, Lvr, conv_rain),             &
                 inc_X_plus_bY(accumulated_fluxes, Lsr, conv_snow),             &
                 inc_X_plus_bY(accumulated_fluxes, graup_factor, ls_graup),     &
                 X_plus_Y(liq_out_total, ls_rain, conv_rain),                   &
                 X_plus_Y(ice_out_total, ls_snow, conv_snow),                   &
                 inc_X_plus_Y(ice_out_total, ls_graup)                          &
    )

    ! -------------------------------------------------------------------------
    ! Energy flux from moisture entering/leaving the atmosphere.
    ! This accounts for the kinetic energy (horizontal only) and internal
    ! energy carried by moisture at the surface level.
    !
    ! Only needed when moist/dry energy formulation includes (1+mt)*KE and
    ! moisture-dependent cv_tot.
    ! -------------------------------------------------------------------------
    if ( new_calculation ) then
      call derived_fields%get_field('exner_in_wth', exner_in_wth)
      call derived_fields%get_field('u_in_w3', u_in_w3)
      call derived_fields%get_field('v_in_w3', v_in_w3)

      call accumulated_fluxes%copy_field_properties(theta_surf)
      call accumulated_fluxes%copy_field_properties(exner_surf)
      call accumulated_fluxes%copy_field_properties(u_surf)
      call accumulated_fluxes%copy_field_properties(v_surf)

      ! Extract surface values from 3D fields
      call invoke( multi_extract_kernel_type(theta_surf, theta, 1, 1),         &
                   multi_extract_kernel_type(exner_surf, exner_in_wth, 1, 1),  &
                   multi_extract_kernel_type(u_surf, u_in_w3, 1, 1),           &
                   multi_extract_kernel_type(v_surf, v_in_w3, 1, 1) )

      ! Compute energy flux from moisture exchange at the surface.
      ! SIMPLIFICATION: The temperature used for the heat capacity with
      ! precipitation is the surface temperature, not the temperature at
      ! which the precipitation "vanished" from the model grid.
      call invoke( moisture_energy_flux_kernel_type( accumulated_fluxes,       &
                       theta_surf, exner_surf, u_surf, v_surf,                 &
                       vap_in_total, liq_out_total, ice_out_total,             &
                       cpv_local, cl_local, ci_local, Rv_local ) )

    end if

  end subroutine sum_fluxes_alg

end module sum_fluxes_alg_mod
