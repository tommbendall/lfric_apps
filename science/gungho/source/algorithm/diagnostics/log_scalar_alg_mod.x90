module log_scalar_alg_mod

  use constants_mod,                    only: r_def, l_def, i_def
  use field_mod,                        only: field_type
  use integer_field_mod,                only: integer_field_type
  use log_mod,                          only: log_event,         &
                                              log_scratch_space, &
                                              LOG_LEVEL_ERROR,   &
                                              LOG_LEVEL_INFO
  use log_column_kernel_mod,       only: log_column_kernel_type
  use sci_geometric_constants_mod, only: get_panel_id

  use function_space_collection_mod, only: function_space_collection
  use mesh_mod,                      only: mesh_type
  use function_space_mod,            only: function_space_type

  implicit none

  private

  public :: log_scalar_column
  public :: log_scalar_minmax

contains

  subroutine log_scalar_minmax(message, field)

    use print_field_stats_alg_mod,    only: print_field_stats_alg

    implicit none

    character(len=*),    intent(in) :: message
    type(field_type),    intent(in) :: field

    call log_event(message, LOG_LEVEL_INFO)
    call print_field_stats_alg(field, LOG_LEVEL_INFO,                          &
                               printmin=1.0E8_r_def, printmax=-1.0E8_r_def,    &
                               name=message)

    call log_scalar_column(message, field, 306)

  end subroutine log_scalar_minmax

  subroutine log_scalar_column(message, field, column_id)

    implicit none

    character(len=*),    intent(in) :: message
    type(field_type),    intent(in) :: field
    integer(kind=i_def), intent(in) :: column_id

    type(field_type) :: dummy
    type(field_type), pointer :: panel_id

    panel_id => get_panel_id(field%get_mesh_id())

    call dummy%initialise(field%get_function_space())

    call log_event(message, LOG_LEVEL_INFO)
    call invoke( log_column_kernel_type(dummy, field, panel_id, column_id) )

  end subroutine log_scalar_column

end module log_scalar_alg_mod
