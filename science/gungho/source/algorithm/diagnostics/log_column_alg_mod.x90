module log_column_alg_mod

  use constants_mod,                    only: r_def, l_def, i_def
  use field_mod,                        only: field_type
  use r_tran_field_mod,                 only: r_tran_field_type
  use log_mod,                          only: log_event,         &
                                              log_scratch_space, &
                                              LOG_LEVEL_ERROR,   &
                                              LOG_LEVEL_INFO
  use log_column_kernel_mod, only: log_column_kernel_type
  use sci_geometric_constants_mod, only: get_panel_id

  implicit none

  private

  public :: log_column
  public :: log_column_rtran

contains

  subroutine log_column(message, field, column_id)

    implicit none

    character(len=*),    intent(in) :: message
    type(field_type),    intent(in) :: field
    integer(kind=i_def), intent(in) :: column_id

    type(field_type) :: dummy
    type(field_type), pointer :: panel_id

    panel_id => get_panel_id(field%get_mesh())

    call dummy%initialise(field%get_function_space())

    call log_event(message, LOG_LEVEL_INFO)
    call invoke( log_column_kernel_type(dummy, field, panel_id, column_id) )

  end subroutine log_column

  subroutine log_column_rtran(message, field_rtran, column_id)

    implicit none

    character(len=*),        intent(in) :: message
    type(r_tran_field_type), intent(in) :: field_rtran
    integer(kind=i_def),     intent(in) :: column_id

    type(r_tran_field_type)   :: dummy_rtran
    type(field_type), pointer :: panel_id

    panel_id => get_panel_id(field_rtran%get_mesh())

    call dummy_rtran%initialise(field_rtran%get_function_space())

    call log_event(message, LOG_LEVEL_INFO)
    call invoke( log_column_kernel_type(dummy_rtran, field_rtran, panel_id, column_id) )

  end subroutine log_column_rtran

end module log_column_alg_mod
