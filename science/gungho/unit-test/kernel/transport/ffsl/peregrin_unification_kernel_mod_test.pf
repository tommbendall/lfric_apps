!> @brief Test the PEREGRIN flux/flux_edge_downwind unification kernel

module peregrin_unification_kernel_mod_test

  use constants_mod, only : i_def, r_tran
  use funit

  implicit none

  private

  public :: test_all

contains

  !------------------------------------------------------------------
  !> @brief Test peregrin_unification_code. Uses nlayers=1 throughout. The
  !!        "own" column's dofs are always 1=W, 2=S, 3=E, 4=N; dof 5 is used
  !!        as a stand-in for the physically-separate edge-adjacent
  !!        reference column reached via the stencil, when k > 1.
  @Test
  subroutine test_all( )

    use, intrinsic :: iso_fortran_env,   only: real64
    use peregrin_unification_kernel_mod, only: peregrin_unification_code

    implicit none

    real(kind=r_tran), parameter :: tol = 1.0e-12_r_tran   ! r_tran 64-bit
    real(kind=r_tran)            :: answer, use_tol

    integer(kind=i_def), parameter :: nlayers = 1
    integer(kind=i_def), parameter :: ndf_w2h = 4
    integer(kind=i_def), parameter :: ndf_pid = 1
    integer(kind=i_def), parameter :: undf_w2h = 6
    integer(kind=i_def), parameter :: undf_pid = 1
    integer(kind=i_def), parameter :: stencil_max = 3

    integer(kind=i_def), dimension(ndf_w2h) :: map_w2h
    integer(kind=i_def), dimension(ndf_pid) :: map_pid
    integer(kind=i_def), dimension(4)                        :: stencil_sizes
    integer(kind=i_def), dimension(ndf_w2h,stencil_max,4)    :: stencil_map

    real(kind=r_tran),   dimension(undf_w2h) :: flux_correction
    real(kind=r_tran),   dimension(undf_w2h) :: flux
    real(kind=r_tran),   dimension(undf_w2h) :: flux_edge_downwind
    real(kind=r_tran),   dimension(undf_w2h) :: dep_dist
    integer(kind=i_def), dimension(undf_pid) :: panel_edge_dist_W
    integer(kind=i_def), dimension(undf_pid) :: panel_edge_dist_E
    integer(kind=i_def), dimension(undf_pid) :: panel_edge_dist_S
    integer(kind=i_def), dimension(undf_pid) :: panel_edge_dist_N
    integer(kind=i_def), dimension(undf_pid) :: face_selector_ew
    integer(kind=i_def), dimension(undf_pid) :: face_selector_ns

    ! Set up maps: dof 1=W, 2=S, 3=E, 4=N (own column); dof 5 stands in for
    ! the physically-separate edge-adjacent reference column
    map_w2h(:) = (/ 1, 2, 3, 4 /)
    map_pid(1) = 1

    stencil_sizes(:) = stencil_max
    ! Dummy fill; only [W,:,W] and [E,:,E] entries are exercised below
    stencil_map(:,:,:) = 1
    stencil_map(1,1,1) = 5  ! W row, branch W, one step back towards edge -> ref
    stencil_map(1,2,1) = 5  ! W row, branch W, two steps back towards edge -> ref

    ! Get correct tolerance
    if ( r_tran == real64 ) then
      use_tol = tol
    else
      use_tol = 1.0e-6_r_tran
    end if

    !-------------------------------------------------------------------------
    ! TEST 1: k=1 (immediately adjacent to a W edge), downwind -> contributes
    !-------------------------------------------------------------------------
    panel_edge_dist_W(1) = 1
    panel_edge_dist_E(1) = 0
    panel_edge_dist_S(1) = 0
    panel_edge_dist_N(1) = 0
    face_selector_ew(1) = 1   ! West only
    face_selector_ns(1) = 0

    flux(:) = 0.0_r_tran
    flux_edge_downwind(:) = 0.0_r_tran
    dep_dist(:) = 0.0_r_tran
    flux(1) = 10.0_r_tran
    flux_edge_downwind(1) = 4.0_r_tran   ! seam = 6.0
    dep_dist(1) = 2.0_r_tran             ! downwind (W side: direction = +1)

    flux_correction(:) = 0.0_r_tran

    call peregrin_unification_code( nlayers,             &
                                    flux_correction,     &
                                    flux,                &
                                    stencil_sizes,       &
                                    stencil_max,         &
                                    stencil_map,         &
                                    flux_edge_downwind,  &
                                    stencil_sizes,       &
                                    stencil_max,         &
                                    stencil_map,         &
                                    dep_dist,            &
                                    panel_edge_dist_W,   &
                                    panel_edge_dist_E,   &
                                    panel_edge_dist_S,   &
                                    panel_edge_dist_N,   &
                                    face_selector_ew,    &
                                    face_selector_ns,    &
                                    ndf_w2h,             &
                                    undf_w2h,            &
                                    map_w2h,             &
                                    ndf_pid,             &
                                    undf_pid,            &
                                    map_pid )

    ! courant = 2.0 -> n_cells = ceiling(3.0) = 3
    ! correction = seam * (n_cells - k) / n_cells = 6.0 * 2 / 3 = 4.0
    answer = 4.0_r_tran
    @assertEqual(answer, flux_correction(1), use_tol)

    !-------------------------------------------------------------------------
    ! TEST 2: k=2 (one cell downwind of a W edge), downwind -> contributes,
    ! reading the seam from the reference (edge-adjacent) column at dof 5
    !-------------------------------------------------------------------------
    panel_edge_dist_W(1) = 2

    flux(5) = 10.0_r_tran
    flux_edge_downwind(5) = 4.0_r_tran   ! seam = 6.0, as at the edge itself
    dep_dist(1) = 1.5_r_tran             ! this column's own departure distance

    flux_correction(:) = 0.0_r_tran

    call peregrin_unification_code( nlayers,             &
                                    flux_correction,     &
                                    flux,                &
                                    stencil_sizes,       &
                                    stencil_max,         &
                                    stencil_map,         &
                                    flux_edge_downwind,  &
                                    stencil_sizes,       &
                                    stencil_max,         &
                                    stencil_map,         &
                                    dep_dist,            &
                                    panel_edge_dist_W,   &
                                    panel_edge_dist_E,   &
                                    panel_edge_dist_S,   &
                                    panel_edge_dist_N,   &
                                    face_selector_ew,    &
                                    face_selector_ns,    &
                                    ndf_w2h,             &
                                    undf_w2h,            &
                                    map_w2h,             &
                                    ndf_pid,             &
                                    undf_pid,            &
                                    map_pid )

    ! courant = 1.5 -> n_cells = ceiling(2.5) = 3
    ! correction = seam * (n_cells - k) / n_cells = 6.0 * 1 / 3 = 2.0
    answer = 2.0_r_tran
    @assertEqual(answer, flux_correction(1), use_tol)

    !-------------------------------------------------------------------------
    ! TEST 3: k=3, downwind, but the Courant-derived n_cells (2) is smaller
    ! than k -> no contribution
    !-------------------------------------------------------------------------
    panel_edge_dist_W(1) = 3
    dep_dist(1) = 0.5_r_tran   ! courant = 0.5 -> n_cells = ceiling(1.5) = 2

    flux_correction(:) = 0.0_r_tran

    call peregrin_unification_code( nlayers,             &
                                    flux_correction,     &
                                    flux,                &
                                    stencil_sizes,       &
                                    stencil_max,         &
                                    stencil_map,         &
                                    flux_edge_downwind,  &
                                    stencil_sizes,       &
                                    stencil_max,         &
                                    stencil_map,         &
                                    dep_dist,            &
                                    panel_edge_dist_W,   &
                                    panel_edge_dist_E,   &
                                    panel_edge_dist_S,   &
                                    panel_edge_dist_N,   &
                                    face_selector_ew,    &
                                    face_selector_ns,    &
                                    ndf_w2h,             &
                                    undf_w2h,            &
                                    map_w2h,             &
                                    ndf_pid,             &
                                    undf_pid,            &
                                    map_pid )

    answer = 0.0_r_tran
    @assertEqual(answer, flux_correction(1), use_tol)

    !-------------------------------------------------------------------------
    ! TEST 4: k=2, but this column is upwind of the edge (wrong sign of
    ! dep_dist) -> no contribution, even though the seam is non-zero
    !-------------------------------------------------------------------------
    panel_edge_dist_W(1) = 2
    dep_dist(1) = -1.0_r_tran   ! upwind for the W side (direction = +1)

    flux_correction(:) = 0.0_r_tran

    call peregrin_unification_code( nlayers,             &
                                    flux_correction,     &
                                    flux,                &
                                    stencil_sizes,       &
                                    stencil_max,         &
                                    stencil_map,         &
                                    flux_edge_downwind,  &
                                    stencil_sizes,       &
                                    stencil_max,         &
                                    stencil_map,         &
                                    dep_dist,            &
                                    panel_edge_dist_W,   &
                                    panel_edge_dist_E,   &
                                    panel_edge_dist_S,   &
                                    panel_edge_dist_N,   &
                                    face_selector_ew,    &
                                    face_selector_ns,    &
                                    ndf_w2h,             &
                                    undf_w2h,            &
                                    map_w2h,             &
                                    ndf_pid,             &
                                    undf_pid,            &
                                    map_pid )

    answer = 0.0_r_tran
    @assertEqual(answer, flux_correction(1), use_tol)

    !-------------------------------------------------------------------------
    ! TEST 5: k=1, downwind, but the seam is zero -> no contribution
    !-------------------------------------------------------------------------
    panel_edge_dist_W(1) = 1
    flux(1) = 3.0_r_tran
    flux_edge_downwind(1) = 3.0_r_tran   ! seam = 0.0
    dep_dist(1) = 2.0_r_tran

    flux_correction(:) = 0.0_r_tran

    call peregrin_unification_code( nlayers,             &
                                    flux_correction,     &
                                    flux,                &
                                    stencil_sizes,       &
                                    stencil_max,         &
                                    stencil_map,         &
                                    flux_edge_downwind,  &
                                    stencil_sizes,       &
                                    stencil_max,         &
                                    stencil_map,         &
                                    dep_dist,            &
                                    panel_edge_dist_W,   &
                                    panel_edge_dist_E,   &
                                    panel_edge_dist_S,   &
                                    panel_edge_dist_N,   &
                                    face_selector_ew,    &
                                    face_selector_ns,    &
                                    ndf_w2h,             &
                                    undf_w2h,            &
                                    map_w2h,             &
                                    ndf_pid,             &
                                    undf_pid,            &
                                    map_pid )

    answer = 0.0_r_tran
    @assertEqual(answer, flux_correction(1), use_tol)

    !-------------------------------------------------------------------------
    ! TEST 6: k=1 on the E side (direction = -1) -> contributes with the
    ! opposite sign convention to the W/S sides
    !-------------------------------------------------------------------------
    panel_edge_dist_W(1) = 0
    panel_edge_dist_E(1) = 1
    face_selector_ew(1) = -1   ! East only
    face_selector_ns(1) = 0

    flux(3) = 8.0_r_tran
    flux_edge_downwind(3) = 5.0_r_tran   ! seam = 3.0
    dep_dist(3) = -2.0_r_tran            ! downwind (E side: direction = -1)

    flux_correction(:) = 0.0_r_tran

    call peregrin_unification_code( nlayers,             &
                                    flux_correction,     &
                                    flux,                &
                                    stencil_sizes,       &
                                    stencil_max,         &
                                    stencil_map,         &
                                    flux_edge_downwind,  &
                                    stencil_sizes,       &
                                    stencil_max,         &
                                    stencil_map,         &
                                    dep_dist,            &
                                    panel_edge_dist_W,   &
                                    panel_edge_dist_E,   &
                                    panel_edge_dist_S,   &
                                    panel_edge_dist_N,   &
                                    face_selector_ew,    &
                                    face_selector_ns,    &
                                    ndf_w2h,             &
                                    undf_w2h,            &
                                    map_w2h,             &
                                    ndf_pid,             &
                                    undf_pid,            &
                                    map_pid )

    ! courant = 2.0 -> n_cells = ceiling(3.0) = 3
    ! correction = direction*seam*(n_cells-k)/n_cells = -1*3.0*2/3 = -2.0
    answer = -2.0_r_tran
    @assertEqual(answer, flux_correction(3), use_tol)

  end subroutine test_all

end module peregrin_unification_kernel_mod_test
