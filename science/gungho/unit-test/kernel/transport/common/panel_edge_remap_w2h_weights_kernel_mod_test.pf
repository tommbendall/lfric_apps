!> Test the generation of interpolation weights/rotation-factors used to
!! remap a W2H field on the cubed-sphere panel extension.
!!
!! The Lagrange donor-stencil part of this test reuses the exact geometry
!! (owned panel 2, edge to panel 1, alpha0/beta0/delta values) already
!! validated by panel_edge_weights_kernel_mod_test.pf, since
!! compute_lagrange_weights here mirrors that kernel's donor-stencil maths
!! exactly (the resulting weights/indices are numerically identical).
!!
!! The NEW part exercised here -- the cos/sin rotation factors between the
!! native and eave coordinate frames, computed by compute_rotation_factors --
!! is cross-checked against an independent python re-implementation of
!! LFRic's own coord_transform_mod formulae (alphabetar2xyz/xyz2alphabetar,
!! using the real PANEL_ROT_MATRIX/INVERSE_PANEL_ROT_MATRIX tables), run as
!! follows:
!!
!!    import numpy as np
!!    ROT = {
!!        1: np.array([[1,0,0],[0,1,0],[0,0,1]], dtype=float),
!!        2: np.array([[0,-1,0],[1,0,0],[0,0,1]], dtype=float),
!!    }
!!    INV = {
!!        1: np.array([[1,0,0],[0,1,0],[0,0,1]], dtype=float),
!!        2: np.array([[0,1,0],[-1,0,0],[0,0,1]], dtype=float),
!!    }
!!    def alphabetar2xyz(alpha, beta, radius, panel):
!!        rho = np.sqrt(1.0 + np.tan(alpha)**2 + np.tan(beta)**2)
!!        p1 = radius/rho * np.array([1.0, np.tan(alpha), np.tan(beta)])
!!        return ROT[panel] @ p1
!!    def xyz2alphabetar(xyz, panel):
!!        p1 = INV[panel] @ xyz
!!        return np.arctan2(p1[1], p1[0]), np.arctan2(p1[2], p1[0])
!!
!!    alpha0, beta0, da = -np.pi/4.0, 0.3, 0.1
!!    owned_panel, neighbour_panel = 2, 1
!!    alpha_native, beta_native = alpha0 - 0.5*da, beta0
!!    alpha_x1, beta_x1 = -alpha0 - 0.5*da, beta0
!!    xyz_e = alphabetar2xyz(alpha_x1, beta_x1, 1.0, neighbour_panel)
!!    alpha_eave, beta_eave = xyz2alphabetar(xyz_e, owned_panel)
!!    parallel_factor = np.cos(beta_eave) / np.cos(beta_native)
!!    perp_factor = -np.sin(beta_eave) / np.cos(alpha_native)
!!    # parallel_factor = 0.9904528634667717
!!    # perp_factor     = -0.4822548014451447
!!
!! giving weights_x_parallel/perp as the (already-validated) Lagrange
!! weights scaled by these two factors.
module panel_edge_remap_w2h_weights_kernel_mod_test

  use constants_mod, only: l_def, i_def, r_def, r_tran, pi, IMDI
  use reference_element_mod, only: S, N
  use funit

  implicit none

  private
  public :: test_all

  @TestCase
  type, extends(TestCase), public :: panel_edge_remap_w2h_weights_test_type
    private
  contains
    procedure setUp
    procedure tearDown
    procedure test_all
  end type panel_edge_remap_w2h_weights_test_type

contains

  !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
  subroutine setUp( this )

    use base_mesh_config_mod,      only : geometry_spherical,                  &
                                          topology_fully_periodic
    use sci_chi_transform_mod,     only : init_chi_transforms
    use extrusion_config_mod,      only : method_uniform,                      &
                                          stretching_method_linear
    use finite_element_config_mod, only : cellshape_quadrilateral,             &
                                          coord_system_native, coord_space_wchi
    use feign_config_mod,          only : feign_finite_element_config,         &
                                          feign_base_mesh_config,              &
                                          feign_extrusion_config,              &
                                          feign_planet_config

    implicit none

    class(panel_edge_remap_w2h_weights_test_type), intent(inout) :: this

    call feign_base_mesh_config(                                               &
        file_prefix='foo',                                                     &
        prime_mesh_name='unit_test',                                           &
        geometry=geometry_spherical,                                           &
        prepartitioned=.false.,                                                &
        topology=topology_fully_periodic,                                      &
        fplane=.false., f_lat_deg=0.0_r_def                                    &
    )
    call feign_extrusion_config(                                               &
        planet_radius=1.0_r_def,                                               &
        domain_height=10.0_r_def,                                              &
        method=method_uniform,                                                 &
        number_of_layers=1_i_def,                                              &
        stretching_method=stretching_method_linear,                            &
        stretching_height=1.0_r_def,                                           &
        eta_values=(/0.5_r_def/)                                               &
    )
    call feign_planet_config(                                                  &
        gravity=9.98_r_def,                                                    &
        omega=7.27E-5_r_def,                                                   &
        rd=300.0_r_def,                                                        &
        cp=1000.0_r_def,                                                       &
        p_zero=100000.0_r_def,                                                 &
        scaling_factor=1.0_r_def                                               &
    )
    call feign_finite_element_config(                                          &
        cellshape=cellshape_quadrilateral,                                     &
        coord_order=0_i_def,                                                   &
        coord_order_nonprime=1_i_def,                                          &
        coord_space=coord_space_wchi,                                          &
        coord_system=coord_system_native,                                      &
        element_order_h=0_i_def,                                               &
        element_order_v=0_i_def,                                               &
        rehabilitate=.true.,                                                   &
        vorticity_in_w1=.false.                                                &
    )

    call init_chi_transforms(geometry_spherical, topology_fully_periodic)

  end subroutine setUp

  !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
  subroutine tearDown( this )

    use config_loader_mod,     only: final_configuration
    use sci_chi_transform_mod, only: final_chi_transforms

    implicit none

    class(panel_edge_remap_w2h_weights_test_type), intent(inout) :: this

    call final_configuration()
    call final_chi_transforms()

  end subroutine tearDown

  @Test
  subroutine test_all( this )

    use panel_edge_remap_w2h_weights_kernel_mod, only: panel_edge_remap_w2h_weights_code
    use base_mesh_config_mod,      only: geometry_spherical, topology_fully_periodic
    use finite_element_config_mod, only: coord_system_native

    implicit none

    class(panel_edge_remap_w2h_weights_test_type), intent(inout) :: this

    real(kind=r_def), parameter    :: tol = 1.0e-5_r_def

    integer(kind=i_def), parameter :: ndata = 4
    integer(kind=i_def), parameter :: nlayers = 1
    integer(kind=i_def), parameter :: ncells = 6
    integer(kind=i_def), parameter :: ndf_ww = 4
    integer(kind=i_def), parameter :: undf_ww = ndata
    integer(kind=i_def), parameter :: ndf_wx = 1
    integer(kind=i_def), parameter :: undf_wx = ncells
    integer(kind=i_def), parameter :: ndf_wx_2d = 1
    integer(kind=i_def), parameter :: undf_wx_2d = ncells
    integer(kind=i_def), parameter :: ndf_pid = 1
    integer(kind=i_def), parameter :: undf_pid = 1 + ncells
    integer(kind=i_def), parameter :: max_length = 3
    integer(kind=i_def), parameter :: remap_depth = 1
    logical(kind=l_def), parameter :: cubic_remap = .true.

    integer(kind=i_def) :: map_ww(ndf_ww)
    integer(kind=i_def) :: map_wx(ndf_wx)
    integer(kind=i_def) :: map_wx_2d(ndf_wx_2d)
    integer(kind=i_def) :: map_pid(ndf_pid)

    integer(kind=i_def) :: wx_stencil_size(4), pid_stencil_size(4)
    integer(kind=i_def) :: wx_stencil(ndf_wx, max_length, 4)
    integer(kind=i_def) :: pid_stencil(ndf_pid, max_length, 4)

    real(kind=r_def)    :: basis_wx(1, ndf_wx, ndf_ww)
    real(kind=r_def)    :: basis_wx_2d(1, ndf_wx_2d, ndf_ww)

    real(kind=r_tran)   :: weights_x_parallel(undf_ww), weights_x_perp(undf_ww)
    real(kind=r_tran)   :: weights_y_parallel(undf_ww), weights_y_perp(undf_ww)
    integer(kind=i_def) :: indices_x(undf_ww), indices_y(undf_ww)

    real(kind=r_def)    :: chi_1(undf_wx), chi_2(undf_wx), chi_3(undf_wx)
    real(kind=r_def)    :: alpha_x(undf_wx_2d), beta_x(undf_wx_2d)
    real(kind=r_def)    :: alpha_y(undf_wx_2d), beta_y(undf_wx_2d)
    real(kind=r_def)    :: panel_id(undf_pid)
    integer(kind=i_def) :: panel_edge_dist_W(undf_pid), panel_edge_dist_E(undf_pid)
    integer(kind=i_def) :: panel_edge_dist_S(undf_pid), panel_edge_dist_N(undf_pid)
    integer(kind=i_def) :: face_selector_ew(undf_pid), face_selector_ns(undf_pid)

    real(kind=r_tran), parameter :: answer_weights_x_parallel(4) = (/          &
        0.771218663268158_r_tran,  0.322156596742333_r_tran,                  &
       -0.058506437872896_r_tran, -0.044415958670824_r_tran                   &
    /)
    real(kind=r_tran), parameter :: answer_weights_x_perp(4) = (/             &
       -0.375508938429813_r_tran, -0.156859121041281_r_tran,                  &
        0.028486979663927_r_tran,  0.021626278362022_r_tran                   &
    /)
    integer(kind=i_def), parameter :: answer_indices_x(4) = (/ 1, 4, 2, 5 /)

    ! Geometry: owned panel 2, edge to panel 1 (matches
    ! panel_edge_weights_kernel_mod_test.pf's already-validated Lagrange
    ! donor-stencil setup)
    real(kind=r_def), parameter :: alpha0 = -pi/4.0_r_def
    real(kind=r_def), parameter :: beta0  = 0.3_r_def
    real(kind=r_def), parameter :: delta_alpha = 0.1_r_def
    real(kind=r_def), parameter :: delta_beta  = 0.1_r_def

    ! Stencil shape (tangential to the S/N edge, used for the x remap):
    !     | 6 |
    !     | 4 |
    ! | . | 1 |
    !     | 3 |
    !     | 5 |
    wx_stencil_size(:) = 1
    wx_stencil_size(S) = 3
    wx_stencil_size(N) = 3
    pid_stencil_size = wx_stencil_size

    map_wx(1) = 1
    map_wx_2d(1) = 1
    ! First entry of panel_id is unused padding; the map points to the
    ! second entry, which holds the owned cell's own panel id
    map_pid(1) = 2

    wx_stencil(1,1,:) = map_wx(1)
    wx_stencil(1,2,S) = 3
    wx_stencil(1,3,S) = 5
    wx_stencil(1,2,N) = 4
    wx_stencil(1,3,N) = 6

    pid_stencil(1,1,:) = map_pid(1)
    pid_stencil(1,2,S) = 3
    pid_stencil(1,3,S) = 5
    pid_stencil(1,2,N) = 4
    pid_stencil(1,3,N) = 6

    ! All cells (owned + donors) are on panel 2
    panel_id(:) = 2.0_r_def

    ! Native (chi) coordinates: index 1 is the owned cell, indices 3-6 are
    ! the tangential (beta-varying) donor cells
    chi_1(1) = alpha0 - 0.5_r_def*delta_alpha
    chi_2(1) = beta0
    chi_1(3) = alpha0 - 0.5_r_def*delta_alpha
    chi_2(3) = beta0 - delta_beta
    chi_1(4) = alpha0 - 0.5_r_def*delta_alpha
    chi_2(4) = beta0 + delta_beta
    chi_1(5) = alpha0 - 0.5_r_def*delta_alpha
    chi_2(5) = beta0 - 2.0_r_def*delta_beta
    chi_1(6) = alpha0 - 0.5_r_def*delta_alpha
    chi_2(6) = beta0 + 2.0_r_def*delta_beta
    chi_3(:) = 1.0_r_def

    ! Extended-mesh coordinates at the owned (target) cell, expressed as
    ! native coordinates on the neighbouring panel (panel 1)
    alpha_x(1) = -alpha0 - 0.5_r_def*delta_alpha
    beta_x(1)  = beta0
    alpha_y(:) = 0.0_r_def
    beta_y(:)  = 0.0_r_def

    ! Only the S face is near a (W) panel edge; W/E/N faces of this owned
    ! cell are not near any relevant edge
    panel_edge_dist_W(:) = 1
    panel_edge_dist_E(:) = -ABS(IMDI)
    panel_edge_dist_S(:) = -ABS(IMDI)
    panel_edge_dist_N(:) = -ABS(IMDI)

    face_selector_ew(:) = 0
    face_selector_ns(:) = 1

    map_ww = (/ IMDI, 1, IMDI, IMDI /)

    ! Point (order-0) coordinate evaluator: the basis is 1 at the S face
    ! node, and unused (0) elsewhere
    basis_wx(:,:,:) = 0.0_r_def
    basis_wx(1,1,S) = 1.0_r_def
    basis_wx_2d(:,:,:) = 0.0_r_def
    basis_wx_2d(1,1,S) = 1.0_r_def

    weights_x_parallel(:) = 0.0_r_tran
    weights_x_perp(:) = 0.0_r_tran
    weights_y_parallel(:) = 0.0_r_tran
    weights_y_perp(:) = 0.0_r_tran
    indices_x(:) = 0
    indices_y(:) = 0

    call panel_edge_remap_w2h_weights_code(                                    &
        nlayers,                                                               &
        weights_x_parallel, weights_x_perp,                                    &
        weights_y_parallel, weights_y_perp,                                    &
        indices_x, indices_y,                                                  &
        chi_1, chi_2, chi_3,                                                   &
        wx_stencil_size, max_length, wx_stencil,                              &
        alpha_x, beta_x, alpha_y, beta_y,                                     &
        panel_id,                                                              &
        pid_stencil_size, max_length, pid_stencil,                            &
        panel_edge_dist_W, panel_edge_dist_E,                                  &
        panel_edge_dist_S, panel_edge_dist_N,                                  &
        face_selector_ew, face_selector_ns,                                   &
        cubic_remap, remap_depth,                                              &
        geometry_spherical, topology_fully_periodic, coord_system_native,     &
        1.0_r_def,                                                             &
        ndf_ww, undf_ww, map_ww,                                              &
        ndf_wx, undf_wx, map_wx, basis_wx,                                    &
        ndf_wx_2d, undf_wx_2d, map_wx_2d, basis_wx_2d,                        &
        ndf_pid, undf_pid, map_pid                                             &
    )

    @assertEqual(answer_weights_x_parallel, weights_x_parallel, real(tol, r_tran))
    @assertEqual(answer_weights_x_perp, weights_x_perp, real(tol, r_tran))
    @assertEqual(answer_indices_x, indices_x)

  end subroutine test_all

end module panel_edge_remap_w2h_weights_kernel_mod_test
