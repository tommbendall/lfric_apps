!> Test the remapping of scalar fields near a cubed-sphere panel corner.
module panel_corner_weights_kernel_mod_test

  use constants_mod, only: l_def, i_def, r_def, r_tran, pi, IMDI
  use reference_element_mod, only: W, S, N, E
  use funit

  implicit none

  private
  public :: test_all

  @TestCase
  type, extends(TestCase), public :: panel_corner_weights_test_type
    private
  contains
    procedure setUp
    procedure tearDown
    procedure test_all
  end type panel_corner_weights_test_type

contains

  !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
  subroutine setUp( this )

    use base_mesh_config_mod,      only : geometry_spherical,                  &
                                          topology_fully_periodic
    use sci_chi_transform_mod,     only : init_chi_transforms
    use extrusion_config_mod,      only : method_uniform,                      &
                                          stretching_method_linear
    use finite_element_config_mod, only : cellshape_quadrilateral,             &
                                          coord_system_native, coord_space_wchi
    use feign_config_mod,          only : feign_finite_element_config,         &
                                          feign_base_mesh_config,              &
                                          feign_extrusion_config,              &
                                          feign_planet_config

    implicit none

    class(panel_corner_weights_test_type), intent(inout) :: this

    call feign_base_mesh_config(                                               &
        file_prefix='foo',                                                     &
        prime_mesh_name='unit_test',                                           &
        geometry=geometry_spherical,                                           &
        prepartitioned=.false.,                                                &
        topology=topology_fully_periodic,                                      &
        fplane=.false., f_lat_deg=0.0_r_def                                    &
    )
    call feign_extrusion_config(                                               &
        planet_radius=1.0_r_def,                                               &
        domain_height=10.0_r_def,                                              &
        method=method_uniform,                                                 &
        number_of_layers=1_i_def,                                              &
        stretching_method=stretching_method_linear,                            &
        stretching_height=1.0_r_def,                                           &
        eta_values=(/0.5_r_def/)                                               &
    )
    call feign_planet_config(                                                  &
        gravity=9.98_r_def,                                                    &
        omega=7.27E-5_r_def,                                                   &
        rd=300.0_r_def,                                                        &
        cp=1000.0_r_def,                                                       &
        p_zero=100000.0_r_def,                                                 &
        scaling_factor=1.0_r_def                                               &
    )
    call feign_finite_element_config(                                          &
        cellshape=cellshape_quadrilateral,                                     &
        coord_order=0_i_def,                                                   &
        coord_order_nonprime=1_i_def,                                          &
        coord_space=coord_space_wchi,                                          &
        coord_system=coord_system_native,                                      &
        element_order_h=0_i_def,                                               &
        element_order_v=0_i_def,                                               &
        rehabilitate=.true.,                                                   &
        vorticity_in_w1=.false.                                                &
    )

    call init_chi_transforms(geometry_spherical, topology_fully_periodic)

  end subroutine setUp

  !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
  subroutine tearDown( this )

    use config_loader_mod,     only: final_configuration
    use sci_chi_transform_mod, only: final_chi_transforms

    implicit none

    class(panel_corner_weights_test_type), intent(inout) :: this

    call final_configuration()
    call final_chi_transforms()

  end subroutine tearDown

  @Test
  subroutine test_all( this )

    use panel_corner_weights_kernel_mod, only: panel_corner_weights_code

    implicit none

    class(panel_corner_weights_test_type), intent(inout) :: this

    real(kind=r_def), parameter :: tol = 1.0e-6_r_def

    integer(kind=i_def), parameter :: nlayers = 1
    integer(kind=i_def), parameter :: ndf_ww = 1
    integer(kind=i_def), parameter :: undf_ww = 32
    integer(kind=i_def), parameter :: ndf_wx = 1
    integer(kind=i_def), parameter :: undf_wx = 16
    integer(kind=i_def), parameter :: ndf_wx_2d = 1
    integer(kind=i_def), parameter :: undf_wx_2d = 16
    integer(kind=i_def), parameter :: ndf_pid = 1
    integer(kind=i_def), parameter :: undf_pid = 16
    integer(kind=i_def), parameter :: wx_max_length = 3
    integer(kind=i_def), parameter :: pid_max_length = 3
    integer(kind=i_def), parameter :: remap_depth = 1
    logical(kind=l_def), parameter :: cubic_remap = .false.

    integer(kind=i_def) :: map_ww(ndf_ww)
    integer(kind=i_def) :: map_wx(ndf_wx)
    integer(kind=i_def) :: map_wx_2d(ndf_wx_2d)
    integer(kind=i_def) :: map_pid(ndf_pid)

    integer(kind=i_def) :: wx_stencil_size(4)
    integer(kind=i_def) :: pid_stencil_size(4)
    integer(kind=i_def) :: wx_stencil_map(ndf_wx, wx_max_length, 4)
    integer(kind=i_def) :: pid_stencil_map(ndf_pid, pid_max_length, 4)

    real(kind=r_def) :: basis_wx(1, ndf_wx, ndf_ww)
    real(kind=r_def) :: basis_wx_2d(1, ndf_wx_2d, ndf_ww)

    real(kind=r_tran)   :: panel_corner_weights_x(undf_ww)
    real(kind=r_tran)   :: panel_corner_weights_y(undf_ww)
    integer(kind=i_def) :: panel_corner_indices_x(undf_ww)
    integer(kind=i_def) :: panel_corner_indices_y(undf_ww)

    real(kind=r_def)    :: alpha(undf_wx)
    real(kind=r_def)    :: beta(undf_wx)
    real(kind=r_def)    :: height(undf_wx)
    real(kind=r_def)    :: alpha_anti(undf_wx_2d)
    real(kind=r_def)    :: beta_anti(undf_wx_2d)
    real(kind=r_def)    :: alpha_clock(undf_wx_2d)
    real(kind=r_def)    :: beta_clock(undf_wx_2d)
    real(kind=r_def)    :: panel_id(undf_pid)
    integer(kind=i_def) :: panel_edge_dist_W(undf_pid)
    integer(kind=i_def) :: panel_edge_dist_E(undf_pid)
    integer(kind=i_def) :: panel_edge_dist_S(undf_pid)
    integer(kind=i_def) :: panel_edge_dist_N(undf_pid)

    integer(kind=i_def) :: i

    map_ww(:) = 0_i_def
    map_wx(:) = 0_i_def
    map_wx_2d(:) = 0_i_def
    map_pid(:) = 0_i_def
    wx_stencil_map = 0_i_def
    pid_stencil_map = 0_i_def
    wx_stencil_size = 3_i_def
    pid_stencil_size = 3_i_def

    map_ww(1) = 1_i_def
    map_wx(1) = 1_i_def
    map_wx_2d(1) = 1_i_def
    map_pid(1) = 1_i_def

    ! Donor stencil values chosen so that a midpoint remap is exactly 1/2, 1/2.
    wx_stencil_map(1,1,S) = 1_i_def
    wx_stencil_map(1,2,S) = 2_i_def
    wx_stencil_map(1,3,S) = 3_i_def
    wx_stencil_map(1,1,N) = 1_i_def
    wx_stencil_map(1,2,N) = 2_i_def
    wx_stencil_map(1,3,N) = 3_i_def
    wx_stencil_map(1,1,W) = 1_i_def
    wx_stencil_map(1,2,W) = 2_i_def
    wx_stencil_map(1,3,W) = 3_i_def
    wx_stencil_map(1,1,E) = 1_i_def
    wx_stencil_map(1,2,E) = 2_i_def
    wx_stencil_map(1,3,E) = 3_i_def

    pid_stencil_map(1,1,S) = 1_i_def
    pid_stencil_map(1,2,S) = 1_i_def
    pid_stencil_map(1,3,S) = 1_i_def
    pid_stencil_map(1,1,N) = 1_i_def
    pid_stencil_map(1,2,N) = 1_i_def
    pid_stencil_map(1,3,N) = 1_i_def
    pid_stencil_map(1,1,W) = 1_i_def
    pid_stencil_map(1,2,W) = 1_i_def
    pid_stencil_map(1,3,W) = 1_i_def
    pid_stencil_map(1,1,E) = 1_i_def
    pid_stencil_map(1,2,E) = 1_i_def
    pid_stencil_map(1,3,E) = 1_i_def

    basis_wx = 0.0_r_def
    basis_wx(1,1,1) = 1.0_r_def
    basis_wx_2d = 0.0_r_def
    basis_wx_2d(1,1,1) = 1.0_r_def

    alpha = 0.0_r_def
    beta = 0.0_r_def
    height = 1.0_r_def
    alpha(1) = 0.0_r_def
    alpha(2) = 1.0_r_def
    alpha(3) = 2.0_r_def
    alpha(4) = 3.0_r_def
    beta(1) = 0.0_r_def
    beta(2) = 1.0_r_def
    beta(3) = 2.0_r_def
    beta(4) = 3.0_r_def

    ! Owned panel 2 touches the west and south neighbours, so the corner branch is
    ! selected and the x/y remaps are both computed at the midpoint in their local
    ! coordinate direction.
    panel_id(:) = 2.0_r_def
    panel_edge_dist_W(:) = 1_i_def
    panel_edge_dist_E(:) = 2_i_def
    panel_edge_dist_S(:) = 1_i_def
    panel_edge_dist_N(:) = 2_i_def

    ! At the corner, the x remap uses the beta-coordinate and the y remap uses the
    ! alpha-coordinate.
    alpha_anti(:) = 0.0_r_def
    beta_anti(:) = 0.5_r_def
    alpha_clock(:) = 0.5_r_def
    beta_clock(:) = 0.0_r_def

    panel_corner_weights_x = 0.0_r_tran
    panel_corner_weights_y = 0.0_r_tran
    panel_corner_indices_x = 0_i_def
    panel_corner_indices_y = 0_i_def

    call panel_corner_weights_code(                                             &
         nlayers,                                                               &
         panel_corner_weights_x,                                                &
         panel_corner_weights_y,                                                &
         panel_corner_indices_x,                                                &
         panel_corner_indices_y,                                                &
         alpha, beta, height,                                                   &
         wx_stencil_size,                                                       &
         wx_stencil_map,                                                        &
         wx_max_length,                                                         &
         alpha_anti, beta_anti,                                                 &
         alpha_clock, beta_clock,                                               &
         panel_id,                                                              &
         pid_stencil_size,                                                      &
         pid_stencil_map,                                                       &
         pid_max_length,                                                        &
         panel_edge_dist_W, panel_edge_dist_E,                                  &
         panel_edge_dist_S, panel_edge_dist_N,                                  &
         cubic_remap,                                                           &
         remap_depth,                                                           &
         ndf_ww, undf_ww, map_ww,                                               &
         ndf_wx, undf_wx, map_wx, basis_wx,                                     &
         ndf_wx_2d, undf_wx_2d, map_wx_2d, basis_wx_2d,                        &
         ndf_pid, undf_pid, map_pid                                             &
    )

    @assertEqual( 0.5_r_tran, panel_corner_weights_x(1), tol )
    @assertEqual( 0.5_r_tran, panel_corner_weights_y(1), tol )
    @assertEqual( 1_i_def, panel_corner_indices_x(1) )
    @assertEqual( 1_i_def, panel_corner_indices_y(1) )

  end subroutine test_all

end module panel_corner_weights_kernel_mod_test
